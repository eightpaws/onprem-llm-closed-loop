# Модель для ollama: тег уже должен лежать в MODELS_DIR, скачан заранее
OLLAMA_MODEL=qwen2.5-coder:14b

# GGUF для llama-server: имя файла внутри GGUF_DIR
GGUF_FILE=qwen2.5-coder-14b-q4_k_m.gguf
GGUF_DIR=./models
MODELS_DIR=./ollama

# Контекст: на 16 ГБ больше 32768 не влезает даже с q8_0 KV
CTX_SIZE=32768
